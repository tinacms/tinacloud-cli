{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "go run tina.io/tinacloud-cli/tools/precommit",
            "statusMessage": "Running make pipeline before commit..."
          }
        ]
      }
    ]
  }
}
